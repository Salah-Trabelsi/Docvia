PORT=3000
NODE_ENV=development
# Public deployment: NODE_ENV=production; keep both Docker flags false.
SERVE_FRONTEND=false
DOCKER_LOCAL_HTTP=false
# Leave empty locally. Set only verified ingress proxy IPs/CIDRs in production.
# Comma-separated; never use blanket trust or guess Render's proxy addresses.
TRUSTED_PROXY_CIDRS=
MONGODB_URI=mongodb://localhost:27017/docvia
FRONTEND_URL=http://localhost:5173
# Set a randomly generated secret of at least 32 characters before starting.
JWT_SECRET=
# Email verification (backend only).
RESEND_API_KEY=
EMAIL_FROM_VERIFY="Docvia <verify@docvia.space>"
EMAIL_FROM_SECURITY="Docvia <security@docvia.space>"
EMAIL_FROM_APPOINTMENTS="Docvia <appointments@docvia.space>"
# Poll the durable appointment email queue in the Express process.
APPOINTMENT_EMAIL_WORKER_ENABLED=true
# Backend-only Cloudinary credentials for avatar uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
