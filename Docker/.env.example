# Copy to Docker/.env. Use a dedicated Atlas test database, never real patients.
MONGODB_URI=
# Independently generated random secret, at least 32 characters.
JWT_SECRET=

# Runtime-only credentials. Needed for verification/reset/account emails.
RESEND_API_KEY=
EMAIL_FROM_VERIFY="Docvia <verify@docvia.space>"
EMAIL_FROM_SECURITY="Docvia <security@docvia.space>"
EMAIL_FROM_APPOINTMENTS="Docvia <appointments@docvia.space>"

# Off by default: no reminder discovery or appointment outbox processing.
# Enable only for an isolated test database with no other worker running.
APPOINTMENT_EMAIL_WORKER_ENABLED=false

# Needed when exercising profile-picture uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
